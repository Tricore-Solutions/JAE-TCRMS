{
  "name": "jae-tcrms",
  "version": "2.0.0",
  "description": "JAE TCRMS — Training and Certification Record Management System",
  "private": true,
  "scripts": {
    "dev": "cd client && npm run dev",
    "dev:mac": "cd client && npm run dev",
    "server": "node scripts/backend-python.js manage.py runserver 0.0.0.0:3000",
    "server:migrate": "node scripts/backend-python.js manage.py migrate",
    "install:backend": "node scripts/install-backend.js",
    "install:client": "cd client && npm install",
    "install:all": "npm run install:backend && npm run install:client",
    "build": "cd client && npm run build",
    "dist": "cd client && npm run dist",
    "dist:win": "cd client && npm run dist",
    "dist:mac": "cd client && npm run dist:mac"
  },
  "author": "JAE Philippines, Inc.",
  "license": "ISC"
}
