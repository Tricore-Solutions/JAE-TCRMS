DEBUG=True
SECRET_KEY=change-this-to-a-secure-random-string
JWT_SECRET=change-this-to-a-secure-random-string

# MySQL — same credentials on Mac (dev) and Windows (production server)
DB_NAME=tcrms
DB_USER=tcrms_user
DB_PASSWORD=tcrms_password
DB_HOST=localhost
DB_PORT=3306

# API port — keep 3000 so Electron clients connect without reconfiguration
PORT=3000
ALLOWED_HOSTS=*
CORS_ALLOW_ALL_ORIGINS=True
